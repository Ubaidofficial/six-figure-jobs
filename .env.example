# Database (Railway provides this automatically)
DATABASE_URL="postgresql://postgres:password@host:5432/railway"

# Site Configuration
NEXT_PUBLIC_SITE_URL="https://www.6figjobs.com"
NODE_ENV=production

# Publishing Configuration
PSEO_ENABLED=false
DOMAIN_AGE_WEEKS=1
PUBLISHING_START_DATE=2025-12-27

# Cron Security
CRON_SECRET=your-secret-here

# Google Indexing API for job posting recrawls (dry-run by default)
INDEXING_API_DRY_RUN=1
INDEXING_API_MAX_URLS=200
# GOOGLE_INDEXING_SERVICE_ACCOUNT_JSON='{"client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}'
# GOOGLE_INDEXING_CLIENT_EMAIL="service-account@project.iam.gserviceaccount.com"
# GOOGLE_INDEXING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
