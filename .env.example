# Database (Railway provides this automatically)
DATABASE_URL="postgresql://postgres:password@host:5432/railway"

# Site Configuration
NEXT_PUBLIC_SITE_URL="https://www.6figjobs.com"
NODE_ENV=production

# SEO rollout controls (set for staged indexing in GSC recovery)
# 1 = advertise only core sitemap families (jobs, company, remote, salary, blog)
SEO_CORE_ONLY=0
# Cap emitted sitemap volume while core-only mode is active.
SEO_CORE_JOB_SITEMAP_SHARDS=1
SEO_CORE_JOB_URLS_PER_SHARD=1000
SEO_CORE_COMPANY_SITEMAP_PAGES=1
SEO_CORE_COMPANY_URLS_PER_PAGE=500
SEO_CORE_REMOTE_SITEMAP_URLS=100

# Publishing Configuration
PSEO_ENABLED=false
DOMAIN_AGE_WEEKS=1
PUBLISHING_START_DATE=2025-12-27

# Cron Security
CRON_SECRET=your-secret-here

# Google Indexing API for job posting recrawls (dry-run by default)
INDEXING_API_DRY_RUN=1
INDEXING_API_MAX_URLS=200

# Option A: OAuth2 refresh token (preferred — run: npm run google:oauth:setup)
# GOOGLE_OAUTH_CLIENT_ID="your-client-id.apps.googleusercontent.com"
# GOOGLE_OAUTH_CLIENT_SECRET="GOCSPX-..."
# GOOGLE_OAUTH_REFRESH_TOKEN="1//..."

# Option B: Service account JSON (fallback)
# GOOGLE_INDEXING_SERVICE_ACCOUNT_JSON='{"client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}'
# GOOGLE_INDEXING_CLIENT_EMAIL="service-account@project.iam.gserviceaccount.com"
# GOOGLE_INDEXING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Internal auth key for POST /api/indexing/notify (generate: openssl rand -hex 32)
# INDEXING_API_INTERNAL_KEY="your-secret-key"
