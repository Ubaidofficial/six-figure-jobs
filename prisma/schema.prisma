generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Job {
  id                        String         @id
  title                     String
  company                   String
  companyLogo               String?
  locationRaw               String?
  city                      String?
  citySlug                  String?
  countryCode               String?
  remote                    Boolean?
  remoteRegion              String?
  remoteMode                String?
  salaryRaw                 String?
  descriptionHtml           String?
  salaryMin                 BigInt?
  salaryMax                 BigInt?
  salaryCurrency            String?
  salaryPeriod              String?
  minAnnual                 BigInt?
  maxAnnual                 BigInt?
  currency                  String?
  isHighSalary              Boolean        @default(false)
  isHundredKLocal           Boolean        @default(false)
  type                      String?
  source                    String
  applyUrl                  String?
  url                       String?
  roleSlug                  String?
  skillsJson                String?
  requirementsJson          String?
  benefitsJson              String?
  externalId                String?
  /// The source's own handle for the posting, when it differs from externalId (freehire: its public_slug). Used to
  /// re-check one posting at the source, e.g. whether it has been closed.
  sourceRef                 String?
  isExpired                 Boolean        @default(false)
  lastSeenAt                DateTime?
  postedAt                  DateTime?
  expiresAt                 DateTime?
  validThrough              DateTime?      @db.Timestamptz(6)
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
  companyId                 String?
  locationId                String?
  dedupeKey                 String?
  sourcePriority            Int            @default(20)
  isUnverifiedBoardJob      Boolean        @default(false)
  experienceLevel           String?        @default("mid")
  employmentType            String?        @default("full-time")
  workArrangement           String?
  visaSponsorship           Boolean        @default(false)
  noDegreeMention           Boolean        @default(false)
  techStack                 String?
  industry                  String?
  stateCode                 String?
  shortId                   String?        @unique
  aiSummaryJson             Json?
  aiSnippet                 String?
  aiOneLiner                String?        @db.VarChar(180)
  aiEnrichedAt              DateTime?
  locationsJson             Json?
  primaryLocation           Json?
  aiBenefits                Json?
  aiRequirements            Json?
  aiWhyHighPay              String?
  aiModel                   String?
  aiVersion                 String?
  aiQualityScore            Int?
  lastAiEnrichedAt          DateTime?      @db.Timestamptz(6)
  salaryConfidence          Int?           @default(0)
  salaryValidated           Boolean        @default(false)
  salarySource              String?
  salaryParseReason         String?
  salaryNormalizedAt        DateTime?      @db.Timestamptz(6)
  salaryRejectedAt          DateTime?      @db.Timestamptz(6)
  salaryRejectedReason      String?
  needsReview               Boolean        @default(false)
  workArrangementNormalized String?
  companyRef                Company?       @relation(fields: [companyId], references: [id])
  locationRef               Location?      @relation(fields: [locationId], references: [id])
  roleInference             RoleInference?

  @@unique([externalId, source], name: "externalId_source")
  @@unique([companyId, dedupeKey], name: "company_dedupeKey")
  @@index([source])
  @@index([roleSlug])
  @@index([countryCode])
  @@index([isHighSalary])
  @@index([isHundredKLocal])
  @@index([companyId])
  @@index([externalId])
  @@index([remoteMode])
  @@index([currency])
  @@index([isExpired])
  @@index([dedupeKey])
  @@index([experienceLevel])
  @@index([industry])
  @@index([workArrangement])
  @@index([stateCode])
  @@index([salaryValidated])
  @@index([salaryConfidence])
  @@index([salarySource])
  @@index([salaryNormalizedAt])
  @@index([needsReview])
  @@index([aiQualityScore])
  @@index([lastAiEnrichedAt])
  @@index([validThrough])

  // Composite indexes for common listing/filter pages (scale to 50k+ jobs)
  @@index([isExpired, createdAt], map: "Job_active_createdAt_idx")
  @@index([isExpired, updatedAt, id], map: "Job_active_updatedAt_id_idx")
  @@index([roleSlug, isExpired, salaryValidated, salaryConfidence], map: "Job_role_salary_gate_idx")
  @@index([countryCode, isExpired, salaryValidated, salaryConfidence], map: "Job_country_salary_gate_idx")
  @@index([citySlug, isExpired, salaryValidated, salaryConfidence], map: "Job_city_salary_gate_idx")
  @@index([remoteMode, remoteRegion, isExpired, salaryValidated, salaryConfidence], map: "Job_remote_salary_gate_idx")
  @@index([companyId, isExpired], map: "Job_company_active_idx")
  @@index([aiEnrichedAt], map: "Job_aiEnrichedAt_idx")
}

model CompanyATS {
  id           String   @id @default(cuid())
  companyName  String
  companySlug  String   @unique
  atsType      String
  atsUrl       String   @unique
  discoveredBy String
  isActive     Boolean  @default(true)
  lastScraped  DateTime?
  jobCount     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([atsType])
  @@index([isActive])
  @@index([lastScraped])
}

model SalaryAggregate {
  id            String   @id @default(cuid())
  sliceType     String
  sliceSlug     String
  currency      String
  minConfidence Int      @default(80)
  jobCount      Int      @default(0)
  minAnnual     BigInt?
  maxAnnual     BigInt?
  avgAnnual     BigInt?
  medianAnnual  BigInt?
  p75Annual     BigInt?
  computedAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([sliceType, sliceSlug, currency], name: "slice_currency_unique", map: "slice_currency_unique")
  @@index([sliceType])
  @@index([sliceSlug])
  @@index([jobCount])
}

model Company {
  id                 String          @id @default(cuid())
  name               String
  slug               String          @unique
  website            String?
  logoUrl            String?
  description        String?
  linkedinUrl        String?
  sizeBucket         String?
  tagsJson           String?
  fundingSummary     String?
  industry           String?
  atsProvider        String?
  atsUrl             String?
  atsSlug            String?
  lastScrapedAt      DateTime?
  scrapeStatus       String?
  scrapeError        String?
  jobCount           Int             @default(0)
  totalJobCount      Int?
  lastJobCountSyncAt DateTime?
  countryCode        String?
  headquarters       String?
  employeeCount      Int?
  fundingStage       String?
  foundedYear        Int?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  sources            CompanySource[]
  jobs               Job[]

  @@index([atsProvider])
  @@index([scrapeStatus])
  @@index([sizeBucket])
  @@index([industry])
  @@index([fundingStage])
}

model CompanySource {
  id            String    @id @default(cuid())
  companyId     String
  sourceType    String
  url           String
  atsProvider   String?
  isActive      Boolean   @default(true)
  lastScrapedAt DateTime?
  lastJobCount  Int       @default(0)
  scrapeStatus  String?
  scrapeError   String?
  priority      Int       @default(100)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, url])
  @@index([atsProvider])
  @@index([isActive])
  @@index([scrapeStatus])
  @@index([priority])
}

model JobSlice {
  id          String   @id @default(cuid())
  slug        String   @unique
  type        String
  filtersJson String
  jobCount    Int      @default(0)
  title       String?
  description String?
  h1          String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([jobCount])
}

model Location {
  id           String   @id @default(cuid())
  locationRaw  String
  city         String?
  citySlug     String?
  region       String?
  countryCode  String?
  isRemote     Boolean? @default(false)
  remoteRegion String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  jobs         Job[]
}

model Skill {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model RoleInference {
  id        String   @id @default(cuid())
  jobId     String   @unique
  roleSlug  String?
  seniority String?
  tagsJson  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model ScrapeRun {
  id               String    @id @default(cuid())
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  companiesTotal   Int       @default(0)
  companiesScraped Int       @default(0)
  companiesFailed  Int       @default(0)
  jobsFound        Int       @default(0)
  jobsNew          Int       @default(0)
  jobsUpdated      Int       @default(0)
  jobsExpired      Int       @default(0)
  status           String    @default("running")
  errorLog         String?
  triggerType      String?

  @@index([status])
  @@index([startedAt])
}

model AiRunLedger {
  id            String   @id @default(cuid())
  day           DateTime @unique
  jobsProcessed Int      @default(0)
  tokensIn      Int      @default(0)
  tokensOut     Int      @default(0)
  lastRunAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}

model Feedback {
  id            String   @id @default(cuid())
  type          String
  message       String
  url           String?
  hasScreenshot Boolean  @default(false)
  /// The pasted screenshot as a data: URL (image/jpeg, png or webp), shrunk in the browser; null before 2026-11-10.
  screenshot    String?
  userAgent     String?
  status        String   @default("new")
  createdAt     DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

model SiteConfig {
  key       String   @id
  value     String
  label     String?
  updatedAt DateTime @updatedAt
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model ErrorLog {
  id         String   @id @default(cuid())
  message    String
  stack      String?
  url        String?
  userAgent  String?
  context    String?
  severity   String   @default("error")
  status     String   @default("new")
  createdAt  DateTime @default(now())

  @@index([status])
  @@index([createdAt])
  @@index([severity])
}

model JobIndexingQueue {
  id             String    @id @default(cuid())
  jobId          String
  url            String
  type           String    // "URL_UPDATED" | "URL_DELETED"
  reason         String    // "new_job", "job_updated", "job_expired", "manual"
  status         String    @default("pending") // "pending", "sent", "failed", "skipped"
  dedupeKey      String    @unique
  attempts       Int       @default(0)
  lastError      String?
  googleResponse String?
  notBefore      DateTime?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([notBefore])
  @@index([createdAt])
}

/// One row per counted click on an Apply button. Deliberately holds nothing about the visitor: no IP, no user agent,
/// no cookie or visitor id. See lib/analytics/applyClick.ts.
model ApplyClick {
  id        String   @id @default(cuid())
  jobId     String
  surface   String // "apply-card" | "mobile-bar"
  device    String // "mobile" | "desktop"
  createdAt DateTime @default(now())

  @@index([jobId, createdAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Accounts and billing. Inert until ACCOUNTS_ENABLED=true (see lib/accounts/config.ts); nothing on a public page
// reads these tables. Sessions are JWT, so there is no Session table. Additive migration only.
// ---------------------------------------------------------------------------

model User {
  id               String         @id @default(cuid())
  name             String?
  email            String?        @unique
  emailVerified    DateTime?
  image            String?
  // Set the first time the user starts a checkout; every Stripe event is mapped to a user through it.
  stripeCustomerId String?        @unique
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  accounts         Account[]
  subscriptions    Subscription[]
  creditLedger     CreditLedger[]
  resume           Resume?
  applicationKits  ApplicationKit[]
  applyProfile     ApplyProfile?
  autoApplications AutoApplication[]
  savedAnswers     SavedAnswer[]
}

// OAuth link (Google). Provider tokens are not stored: lib/auth/config.ts drops them before the adapter writes.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// Magic-link tokens (hashed by Auth.js before they are stored).
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Mirror of the Stripe subscription, written only by the webhook.
model Subscription {
  id                   String    @id @default(cuid())
  userId               String
  stripeCustomerId     String
  stripeSubscriptionId String    @unique
  status               String
  priceId              String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  // `created` of the Stripe event that last wrote this row; older events are ignored (they can arrive out of order).
  lastEventAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([stripeCustomerId])
}

// Append-only. Balance = SUM(delta). Rows are inserted, never updated or deleted. idempotencyKey makes every grant,
// spend and clawback safe to retry.
model CreditLedger {
  id             String   @id @default(cuid())
  userId         String
  delta          Int
  // 'subscription_grant' | 'pack' | 'spend' | 'refund'
  kind           String
  reason         String
  // Stripe invoice / payment intent / charge id for money-related rows.
  refId          String?
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([refId])
}

// Stripe event ids already processed (webhook idempotency).
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

// The user's résumé as plain text (one per user). Private: only ever read for its owner, deleted on request.
model Resume {
  userId    String   @id
  text      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A generated application kit for one job, doubling as the user's application tracker row. jobId has no foreign key
// on purpose: the entry must outlive an expired or deleted job, so the title/company/apply link are copied here.
model ApplicationKit {
  id          String    @id @default(cuid())
  userId      String
  jobId       String
  jobSlug     String
  jobTitle    String
  companyName String
  applyUrl    String?
  // Résumé version (Resume.updatedAt in ms) this kit was made from; a changed résumé is a new, separately charged kit.
  resumeStamp String
  coverLetter String    @db.Text
  bullets     Json
  keywordGaps Json
  // 'saved' | 'applied' | 'interview' | 'offer' | 'rejected'
  status      String    @default("saved")
  notes       String?   @db.Text
  appliedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId, updatedAt])
}

// What the user lets us put on application forms (the résumé is in Resume; the email is the account's). One per user.
model ApplyProfile {
  userId    String   @id
  firstName String
  lastName  String
  phone     String
  country   String?
  city      String?
  linkedin  String?
  website   String?
  github    String?
  // Answers to common application questions, typed by the user, matched to questions by their label (plan.ts).
  currentCompany    String?
  currentTitle      String?
  state             String?
  postalCode        String?
  noticePeriod      String?
  salaryExpectation String?
  languages         String?
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// An answer the user gave to an employer's question, kept (unless they opt out) so the same question on a later
// application can start from it. Never used without the user ticking it on that application; questions about
// demographics (EEO) are never kept. Choices are stored as the option wording, not one employer's option ids.
model SavedAnswer {
  id          String   @id @default(cuid())
  userId      String
  // The question as the employer worded it last time, and its normalised form used for exact matching.
  question    String
  questionKey String
  // 'text' | 'textarea' | 'single' | 'multi'
  type        String
  // A string for text, an array of option labels for choices.
  answer      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionKey, type])
  @@index([userId])
}

// One hosted application the user reviewed and approved. `plan` is the exact set of answers that gets submitted;
// `planHash` is its hash when the user approved it, so nothing can change between approval and submission.
model AutoApplication {
  id          String    @id @default(cuid())
  userId      String
  jobId       String
  jobSlug     String
  jobTitle    String
  companyName String
  applyUrl    String
  board       String
  ghJobId     String
  // 'draft' | 'approved' | 'submitting' | 'submitted' | 'needs_user' | 'failed' | 'cancelled'
  status      String    @default("draft")
  plan        Json
  planHash    String?
  approvedAt  DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?
  // Why it stopped: 'captcha', 'security_code', 'login', 'unexpected_field', 'validation', 'resume_changed', ...
  reason      String?
  // A short piece of the employer's confirmation page, kept as proof of submission.
  evidence    String?   @db.Text
  // 'none' | 'charged' | 'unpaid' (submitted, but the credits could not be taken afterwards)
  charge      String    @default("none")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
}

// One attempt by the auto-apply worker (dry run or live), kept so the owner can see where real employer forms stop before
// selling auto-apply. Append-only. Holds no answers, names or résumé text: only the board, the outcome, why it stopped and
// which form questions were left empty (their key and the employer's own label). applicationId has no foreign key on
// purpose: the statistics must outlive an application deleted with its user.
model AutoApplyRun {
  id            String   @id @default(cuid())
  applicationId String
  board         String
  // 'dry_run' | 'live'
  mode          String
  // 'dry_run' | 'submitted' | 'needs_user' | 'failed'
  outcome       String
  // Why it stopped (the same codes as AutoApplication.reason); null for a submission or a dry run.
  reason        String?
  filledCount   Int      @default(0)
  // [{ key, label }] of required questions still empty when the worker stopped.
  unfilled      Json?
  durationMs    Int?
  createdAt     DateTime @default(now())

  @@index([board, createdAt])
  @@index([createdAt])
}

// An email job alert: a saved search (the listing page's own job query) mailed daily or weekly. No account needed:
// double opt-in, and every link carries the alert's random token (confirm, change frequency, unsubscribe).
model JobAlert {
  id             String         @id @default(cuid())
  email          String
  // Optional, typed by the subscriber on the signup form (letters, spaces, ' . - only; at most 40 characters).
  firstName      String?
  // 32 random bytes, hex. The only secret in the alert's links; never derived from the email.
  token          String         @unique
  // The saved search: a whitelisted subset of JobQueryInput (lib/alerts/filters.ts), run through buildWhere.
  filters        Json
  // Canonical JSON of `filters`, so the same email cannot hold the same search twice.
  filtersKey     String
  // 'daily' | 'weekly'
  frequency      String         @default("weekly")
  // 'pending' (not confirmed) | 'active' | 'unsubscribed'
  status         String         @default("pending")
  // The site path the visitor signed up on ("/jobs/data-engineer", "/remote"): which pages grow the list.
  source         String?
  confirmedAt    DateTime?
  lastSentAt     DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  sent           JobAlertSent[]

  @@unique([email, filtersKey])
  @@index([status, lastSentAt])
  @@index([email, createdAt])
}

// Which jobs an alert has already mailed, so a job is never sent twice to the same alert. jobId has no foreign key on
// purpose: the record must outlive an expired or deleted job.
model JobAlertSent {
  alertId String
  jobId   String
  sentAt  DateTime @default(now())
  alert   JobAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@id([alertId, jobId])
  @@index([sentAt])
}

// ---- Data history (added 2026-11-16) ----------------------------------------------------------------------------------
// Append-only records that outlive the rows they describe, so reports can compare today with earlier weeks. Before these,
// SalaryAggregate (one overwritten row per slice) and Job.lastSeenAt (overwritten by every scrape) kept no history, and a
// year-on-year figure would have had nothing to compare with. None of these tables is read by a page.

// One row per job: when it was first stored, last seen live, seen expired, reopened, and each change of its pay. jobId has no
// foreign key on purpose (as JobAlertSent): the row must outlive an expired or deleted job. Written by
// scripts/observeJobLifecycle.ts; history starts at its first run, and "days listed" is first seen to expiry OBSERVED, not
// time to fill (a listing coming down does not say whether anyone was hired).
model JobLifecycle {
  jobId              String    @id
  source             String
  company            String
  companyId          String?
  roleSlug           String?
  countryCode        String?
  currency           String?
  firstSeenAt        DateTime  @db.Timestamptz(6)
  postedAt           DateTime? @db.Timestamptz(6)
  lastObservedLiveAt DateTime  @db.Timestamptz(6)
  expiredObservedAt  DateTime? @db.Timestamptz(6)
  reopenCount        Int       @default(0)
  lastMinAnnual      BigInt?
  lastMaxAnnual      BigInt?
  payChangeCount     Int       @default(0)
  /// Up to the last 20 changes: [{ at, min, max, currency }].
  payHistory         Json?
  updatedAt          DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([source])
  @@index([expiredObservedAt])
  @@index([roleSlug, countryCode])
}

// The sentence a field was read from, and which reader and version read it, so a stored value can be audited and a reader's
// precision measured. field is "benefits" or "remoteMode"; value is the label or mode. No foreign key (see JobLifecycle).
model JobEvidence {
  id               String   @id @default(cuid())
  jobId            String
  field            String
  value            String
  quote            String
  extractor        String
  extractorVersion Int
  createdAt        DateTime @default(now()) @db.Timestamptz(6)

  @@unique([jobId, field, value])
  @@index([field, value])
}

// Weekly pay by cell, one row per (date, dimension, key, currency), under lib/research/method.ts's rules (methodVersion). Pay
// is never converted between currencies. dimension: all | role | country | role_country | level | arrangement.
model MarketSnapshot {
  id            String   @id @default(cuid())
  snapshotDate  DateTime @db.Date
  dimension     String
  key           String
  currency      String
  jobs          Int
  companies     Int
  p25           Int
  median        Int
  p75           Int
  newJobs7d     Int
  methodVersion String
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  @@unique([snapshotDate, dimension, key, currency])
  @@index([dimension, key, currency, snapshotDate])
}

// A weekly data-quality scorecard: fill rates and counts, as JSON, so the trend can be read (scripts/dataScorecard.ts).
model DataScorecard {
  id         String   @id @default(cuid())
  capturedAt DateTime @default(now()) @db.Timestamptz(6)
  metrics    Json

  @@index([capturedAt])
}

// Apply clicks per week, rolled up by dimension (all | company | role | country | source), so demand survives and reports do not
// scan the raw ApplyClick table. Holds counts only: ApplyClick itself stores no IP, user agent or visitor id.
model ApplyClickWeekly {
  id        String   @id @default(cuid())
  weekStart DateTime @db.Date
  dimension String
  key       String
  clicks    Int
  jobs      Int
  mobile    Int
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([weekStart, dimension, key])
