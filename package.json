{
  "name": "job-board-scraper",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:staging": "dotenv -e .env.staging.local -- next dev -p 3001",
    "dev:prod": "dotenv -e .env.production.local -- next dev -p 3000",
    "build": "npx prisma migrate deploy && npx prisma generate && next build --webpack",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:push:staging": "dotenv -e .env.staging.local -- npx prisma db push",
    "db:migrate:staging": "dotenv -e .env.staging.local -- npx prisma migrate dev",
    "db:studio:staging": "dotenv -e .env.staging.local -- npx prisma studio",
    "jobs:audit:currency": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/repairCurrencyAndSalary.ts --mode=audit --dry-run",
    "jobs:repair:currency": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/repairCurrencyAndSalary.ts --mode=repair",
    "jobs:annotate:ai": "tsx scripts/aiAnnotateJobs.ts",
    "jobs:backfill:salary": "tsx scripts/backfill-high-salary-local.ts",
    "jobs:backfill:salary-quality:v2.9": "tsx scripts/backfill-salary-quality-v2.9.ts",
    "backfill:role-slugs": "tsx scripts/backfill-role-slugs.ts",
    "backfill:locations": "tsx scripts/backfillLocations.ts",
    "audit:ci": "tsx scripts/audit-v2.9.ts",
    "scraper:smoke": "tsx scripts/smokeScrapers.ts",
    "scraper:ats:report": "tsx scripts/reportAtsCoverage.ts",
    "pseo:report": "node --import tsx scripts/reportPseoKpis.ts",
    "scrape:db-target": "node --import tsx scripts/checkDbTarget.ts",
    "scrape:health": "node --import tsx scripts/checkJobFreshness.ts",
    "scrape:pseo:health": "node --import tsx scripts/checkPseoOutputs.ts",
    "scrape:dice": "tsx scripts/dailyScrapeV2.ts --mode=boards --source=dice",
    "scrape:wellfound": "tsx scripts/dailyScrapeV2.ts --mode=boards --source=wellfound",
    "scrape:otta": "tsx scripts/dailyScrapeV2.ts --mode=boards --source=otta",
    "scrape:builtin": "tsx scripts/dailyScrapeV2.ts --mode=boards --source=builtin",
    "publish:pseo-batch": "tsx scripts/publish-pseo-batch.ts",
    "pseo:generate:playbook-batch": "tsx scripts/generate-playbook-batch.ts",
    "dashboard:pseo": "tsx scripts/monitoring-dashboard.ts",
    "generate:sitemap": "tsx scripts/generate-sitemap.ts",
    "google:indexing:jobs": "node --import tsx scripts/notify-google-indexing.ts",
    "google:oauth:setup": "npx tsx scripts/setup-google-oauth.ts",
    "seo:validate": "tsx scripts/seo-validate.ts",
    "seo:validate:strict": "SEO_STRICT=1 SEO_SAMPLE_PER_SITEMAP=1000 SEO_CONCURRENCY=4 SEO_TIMEOUT_MS=60000 tsx scripts/seo-validate.ts",
    "seo:audit:best-practices": "node --import tsx scripts/audit-job-board-best-practices.ts",
    "seo:audit:full": "node --import tsx scripts/audit-project-health.ts",
    "seo:audit:full:strict": "SEO_AUDIT_STRICT=1 node --import tsx scripts/audit-project-health.ts --strict",
    "seo:sample": "tsx scripts/seo-template-sanity.ts",
    "seo:indexable:report": "tsx scripts/report-indexable-jobs.ts",
    "test": "jest",
    "changelog:generate": "conventional-changelog -p angular -i CHANGELOG.generated.md -s -r 0",
    "changelog:check": "node scripts/checkChangelogUpdated.js"
  },
  "dependencies": {
    "@prisma/client": "^5.16.1",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toast": "^1.2.15",
    "axios": "^1.6.0",
    "cheerio": "^1.0.0-rc.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.561.0",
    "next": "^16.0.4",
    "next-themes": "^0.4.6",
    "openai": "^6.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "slugify": "^1.6.6",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/puppeteer": "^5.4.7",
    "@types/react": "19.2.6",
    "autoprefixer": "^10.4.23",
    "baseline-browser-mapping": "^2.10.19",
    "conventional-changelog-cli": "^5.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.0.10",
    "jest": "^30.2.0",
    "postcss": "^8.5.6",
    "prisma": "^5.16.1",
    "puppeteer": "^24.31.0",
    "tailwindcss": "^3.4.18",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0",
    "vitest": "^4.0.14"
  }
}
